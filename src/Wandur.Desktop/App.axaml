<Application xmlns="https://github.com/avaloniaui"
             xmlns:l="clr-namespace:Wandur.Core.Localization;assembly=Wandur.Core"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:Wandur.Desktop"
             xmlns:dock="clr-namespace:Dock.Avalonia.Themes.Fluent;assembly=Dock.Avalonia.Themes.Fluent"
             xmlns:dc="using:Dock.Avalonia.Controls"
             xmlns:conv="using:Wandur.Desktop.Converters"
             xmlns:dm="using:Dock.Model.Controls"
             x:Class="Wandur.Desktop.App" Name="Wandur" RequestedThemeVariant="Dark">
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="{ReflectionBinding [AboutWandur], Source={x:Static loc:LocalizedText.Instance}}" Click="AboutClicked" />
      <NativeMenuItemSeparator />
      <NativeMenuItem Header="{ReflectionBinding [Preferences], Source={x:Static loc:LocalizedText.Instance}}" Gesture="Meta+OemComma" Click="PreferencesClicked" />
    </NativeMenu>
  </NativeMenu.Menu>
  <Application.Resources>
    <!-- Three corner radii carry the whole UI: small for dense inline chrome, control for inputs and
         buttons, card for containers and the dock chrome (DockChromeConverter.Radius matches Card).
         ThemeService overrides these when a world theme supplies its own radius. -->
    <CornerRadius x:Key="SmallCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
    <!-- How far disabled chrome dims towards its surface; ThemeService raises it on light presets. -->
    <x:Double x:Key="DisabledOpacity">0.55</x:Double>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <dock:DockFluentTheme />
    <StyleInclude Source="avares://Wandur/Styles/ThemeDockSkin.axaml" />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="{DynamicResource ShellBrush}" />
    </Style>
    <Style Selector="Button.app-button">
      <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}" />
      <Setter Property="Background" Value="{DynamicResource ButtonFaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="ButtonSurface" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                  BoxShadow="0 2 3 0 #40000000">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="Center" RecognizesAccessKey="True" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.app-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
    </Style>
    <Style Selector="Button.app-button.primary">
      <Setter Property="Background" Value="{DynamicResource PrimaryFaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryEdgeBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.app-button.primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
    </Style>
    <Style Selector="Button.app-button:pressed /template/ Border#ButtonSurface">
      <Setter Property="RenderTransform" Value="translate(0px, 1px)" />
      <Setter Property="BoxShadow" Value="inset 0 2 3 0 #40000000" />
    </Style>
    <Style Selector="Button.app-button:focus-visible /template/ Border#ButtonSurface">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BoxShadow" Value="0 0 0 2 #607F9CC0" />
    </Style>
    <Style Selector="Button.app-button:disabled">
      <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}" />
    </Style>
    <Style Selector="Button.app-button:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.app-button:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.app-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.app-button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.app-button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.app-button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <Style Selector="Button.app-button.quiet">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <!-- Fluent derives these from palette brushes the control resolves once, so they kept the previous
           theme's colour across a switch: the caret vanished entirely on a dark world. -->
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource WorldSelectionBrush}" />
      <Setter Property="Background" Value="{DynamicResource ShellBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    </Style>
    <Style Selector="TextBox.terminal-field">
      <Setter Property="Background" Value="{DynamicResource TerminalBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TerminalTextBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource TerminalTextBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource TranscriptSelectionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="TextBox:focus, TextBox:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement, TextBox:focus /template/ Border#PART_BorderElement, TextBox:disabled /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource ShellBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- Terminal fields must win over the shell template styles above: Fluent paints PART_BorderElement
         on focus/hover/disabled, and a later shell setter would otherwise bleach a dark transcript input. -->
    <Style Selector="TextBox.terminal-field:focus, TextBox.terminal-field:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TerminalTextBrush}" />
    </Style>
    <Style Selector="TextBox.terminal-field /template/ Border#PART_BorderElement, TextBox.terminal-field:pointerover /template/ Border#PART_BorderElement, TextBox.terminal-field:focus /template/ Border#PART_BorderElement, TextBox.terminal-field:disabled /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource TerminalBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    </Style>
    <Style Selector="TextBox.terminal-field:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBox.terminal-field:disabled">
      <Setter Property="Foreground" Value="{DynamicResource TerminalTextBrush}" />
    </Style>
    <!-- Placeholders are not styled here. Fluent writes the foreground and a fixed 0.5 opacity straight
         onto the template element, and a local value outranks every style setter, so a selector for
         PART_Placeholder or PlaceholderTextBlock silently matches nothing. ThemeService reaches the colour
         through the TextControlPlaceholderForeground and ComboBoxPlaceHolderForeground resource keys; the
         opacity stays out of reach without retemplating TextBox and ComboBox. -->
    <Style Selector="TextBox:disabled">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="TextBox.terminal-field:disabled">
      <Setter Property="Foreground" Value="{DynamicResource TerminalTextBrush}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="ComboBox:disabled, ToggleButton:disabled, CheckBox:disabled">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="dc|ToolChromeControl /template/ Button">
      <Setter Property="Foreground" Value="{DynamicResource DockHeaderGlyphBrush}" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="10" />
      <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>
    <Style Selector="ListBox.world-list ListBoxItem">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="CornerRadius" Value="{DynamicResource SmallCornerRadius}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="WorldRowPresenter" Background="Transparent"
                              Foreground="{DynamicResource TextBrush}" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.world-list ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    </Style>
    <Style Selector="ListBox.world-list ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource WorldSelectionBrush}" />
    </Style>
    <Style Selector="ListBox.world-list ListBoxItem:focus-visible">
      <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
    </Style>
    <!-- A docked panel is rounded on its outer edge only (left docks on the left, right docks on the right) and keeps the 4 px gap there, so the side docks meet the square centre flush. -->
    <Style Selector="dc|ToolControl /template/ Border#PART_Border" x:DataType="dm:IToolDock">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="CornerRadius" Value="{Binding Alignment, Converter={x:Static conv:DockChromeConverter.Instance}, ConverterParameter=ContentCorner, FallbackValue='0,0,10,10'}" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Margin" Value="{Binding Alignment, Converter={x:Static conv:DockChromeConverter.Instance}, ConverterParameter=ContentMargin, FallbackValue='4,0,4,4'}" />
    </Style>
    <Style Selector="dc|ToolChromeControl /template/ Border#PART_Border" x:DataType="dm:IToolDock">
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonEdgeBrush}" />
      <Setter Property="Margin" Value="{Binding Alignment, Converter={x:Static conv:DockChromeConverter.Instance}, ConverterParameter=HeaderMargin, FallbackValue='4,4,4,0'}" />
      <Setter Property="CornerRadius" Value="{Binding Alignment, Converter={x:Static conv:DockChromeConverter.Instance}, ConverterParameter=HeaderCorner, FallbackValue='10,10,0,0'}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!-- A floated panel has no neighbour to meet, so it keeps the symmetric chrome it always had. -->
    <Style Selector="dc|ToolChromeControl:floating /template/ Border#PART_Border">
      <Setter Property="Margin" Value="8,12,8,0" />
      <Setter Property="CornerRadius" Value="10,10,0,0" />
    </Style>
    <Style Selector="dc|ToolChromeControl:floating dc|ToolControl /template/ Border#PART_Border">
      <Setter Property="Margin" Value="8,0,8,12" />
      <Setter Property="CornerRadius" Value="0,0,10,10" />
    </Style>
    <!-- The whole header drags, but only the grip glyph shows the move cursor; the title and the space around it show a plain arrow. -->
    <Style Selector="dc|ToolChromeControl /template/ Grid#PART_Grip, dc|ToolChromeControl:active /template/ Grid#PART_Grip">
      <Setter Property="Background" Value="{DynamicResource DockHeaderBrush}" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="dc|ToolChromeControl /template/ Grid#PART_Grid">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Margin" Value="6,0,8,0" />
      <Setter Property="Cursor" Value="SizeAll" />
      <Setter Property="ToolTip.Tip" Value="Drag to move or undock this panel" />
    </Style>
    <Style Selector="dc|ToolChromeControl /template/ Button">
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="dc|ToolChromeControl /template/ Button Viewbox">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
    </Style>
    <Style Selector="dc|ToolChromeControl /template/ Button#PART_CloseButton">
      <Setter Property="ToolTip.Tip" Value="Close panel · reopen from the View menu" />
      <Setter Property="AutomationProperties.Name" Value="Close panel" />
      <Setter Property="Background" Value="{DynamicResource ButtonFaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource SmallCornerRadius}" />
    </Style>
    <Style Selector="dc|ToolChromeControl /template/ Button#PART_CloseButton:pointerover">
      <Setter Property="Background" Value="#934A47" />
    </Style>
    <Style Selector="dc|ToolChromeControl /template/ TextBlock#PART_Title">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <!-- The centre document is squared off and butts straight against the splitters on either side. -->
    <Style Selector="dc|DocumentControl /template/ Border#PART_Border">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Margin" Value="0,4,0,4" />
    </Style>
    <!-- Labelled toolbar pills: same density as the titlebar icon buttons, without chrome wells. -->
    <Style Selector="Button.app-button.toolbar-button">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="11,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="{DynamicResource SmallCornerRadius}" />
    </Style>
    <Style Selector="TabStripItem.output-footer-tab">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="14,3" />
      <Setter Property="Margin" Value="0,-1,2,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1,0,1,1" />
      <Setter Property="CornerRadius" Value="0,0,5,5" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabStripItem.output-footer-tab:pointerover">
      <Setter Property="Background" Value="{DynamicResource ToolbarHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TabStripItem.output-footer-tab:selected">
      <Setter Property="Background" Value="{DynamicResource TerminalBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabStripItem.output-footer-tab:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <!-- Flat toolbar controls, including toggle buttons, share hover and keyboard focus states. -->
    <Style Selector=":is(Button).command-bar-button">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="CornerRadius" Value="{DynamicResource SmallCornerRadius}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector=":is(Button).command-bar-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource ToolbarHoverBrush}" />
    </Style>
    <Style Selector=":is(Button).command-bar-button:pressed, :is(ToggleButton).command-bar-button:checked">
      <Setter Property="Background" Value="{DynamicResource ToolbarPressedBrush}" />
    </Style>
    <Style Selector=":is(Button).command-bar-button:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector=":is(Button).command-bar-button:disabled">
      <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- The custom template keeps Fluent's PART_ContentPresenter name, so Fluent's own disabled rule still
         claims the foreground and dims it a second time on top of DisabledOpacity. -->
    <Style Selector=":is(Button).command-bar-button:disabled /template/ ContentPresenter#PART_ContentPresenter, :is(Button).command-bar-button:pointerover /template/ ContentPresenter#PART_ContentPresenter, :is(Button).command-bar-button:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.command-bar-button:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="ComboBox.toolbar-world-picker">
      <Setter Property="Background" Value="{DynamicResource ShellBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{DynamicResource SmallCornerRadius}" />
    </Style>
    <Style Selector="Button.tab-close">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="20" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                            Background="Transparent" Padding="0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.tab-close:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.tab-close:pressed">
      <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="Button.workspace-nav, ToggleButton.workspace-nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="WorkspaceNavigationPresenter" Content="{TemplateBinding Content}"
                            Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.workspace-nav:pointerover, ToggleButton.workspace-nav:pointerover">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    </Style>
    <Style Selector="ToggleButton.workspace-nav:checked">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="ToggleButton#WorkspaceFindMud:checked">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    </Style>
    <Style Selector="ListBox.script-library, ListBox.protocol-messages">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.script-library ListBoxItem, ListBox.protocol-messages ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="ListBox.script-library ListBoxItem:selected /template/ Border#PART_LayoutRoot, ListBox.protocol-messages ListBoxItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
    </Style>
    <Style Selector="ListBox.script-library ListBoxItem:pointerover /template/ Border#PART_LayoutRoot, ListBox.protocol-messages ListBoxItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    </Style>
    <Style Selector="ListBox.script-library ListBoxItem:selected /template/ ContentPresenter, ListBox.protocol-messages ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector=":is(Button).diag-chip">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Margin" Value="0,0,6,4" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector=":is(Button).diag-chip /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector=":is(Button).diag-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ToolbarHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="ToggleButton.diag-chip:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.diag-chip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ToolbarPressedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ToolTip">
      <Setter Property="MaxWidth" Value="320" />
    </Style>
  </Application.Styles>
</Application>
