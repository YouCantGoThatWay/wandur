<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dc="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
        xmlns:dmc="clr-namespace:Dock.Model.Controls;assembly=Dock.Model"
        xmlns:local="using:Wandur.Desktop"
        x:CompileBindings="False">

  <!-- Wrap each ToolDock's chrome+body in the panel skin host. PART names and DataContext stay intact. -->
  <Styles.Resources>
    <ControlTheme x:Key="{x:Type dc:ToolDockControl}" TargetType="dc:ToolDockControl" x:DataType="dmc:IToolDock">
      <Setter Property="(AutomationProperties.AutomationId)" Value="{Binding Id}" />
      <Setter Property="(AutomationProperties.Name)" Value="{Binding Title}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="MinWidth" Value="{Binding MinWidth}" />
      <Setter Property="MaxWidth" Value="{Binding MaxWidth}" />
      <Setter Property="MinHeight" Value="{Binding MinHeight}" />
      <Setter Property="MaxHeight" Value="{Binding MaxHeight}" />
      <Setter Property="Template">
        <ControlTemplate>
          <local:ThemeDockSkinHost Name="PART_DockSkin">
            <dc:DockableControl Name="PART_DockableControl"
                                TrackingMode="Visible"
                                Background="{TemplateBinding Background}"
                                DockProperties.IsDropArea="True"
                                DockProperties.IsDockTarget="True">
              <dc:ToolChromeControl IsActive="{Binding IsActive}"
                                    IsVisible="{Binding !!VisibleDockables.Count}">
                <dc:ToolControl />
              </dc:ToolChromeControl>
            </dc:DockableControl>
          </local:ThemeDockSkinHost>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>

  <!-- Suppress plain chrome surfaces only while the panel skin bitmap is active. -->
  <Style Selector="local|ThemeDockSkinHost[IsSkinActive=True] dc|ToolChromeControl /template/ Border#PART_Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <!-- Extra air between bevel/cyan lamps and live title/buttons; keep button size consistent. -->
  <Style Selector="local|ThemeDockSkinHost[IsSkinActive=True] dc|ToolChromeControl /template/ Button">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="3,0" />
  </Style>
  <!-- Panel header slot: the row is pulled back out of the panel's body inset so it sits in the art's
       own header band and the title gets the panel's full width. Both values come from the theme. -->
  <Style Selector="local|ThemeDockSkinHost[IsSkinActive=True] dc|ToolChromeControl /template/ Grid#PART_Grip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Margin" Value="{DynamicResource DockHeaderMargin}" />
    <Setter Property="Height" Value="{DynamicResource DockHeaderHeight}" />
  </Style>
  <Style Selector="local|ThemeDockSkinHost[IsSkinActive=True] dc|ToolControl /template/ Border#PART_Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <!-- Code-drawn Fleet panels use the real Dock template, independent of bitmap readiness. -->
  <Style Selector="local|ThemeDockSkinHost.fleet">
    <Setter Property="Margin" Value="1,0,1,0" />
  </Style>
  <Style Selector="local|ThemeDockSkinHost.fleet.joined-left">
    <Setter Property="Margin" Value="0,0,1,0" />
  </Style>
  <Style Selector="local|ThemeDockSkinHost.fleet.joined-right">
    <Setter Property="Margin" Value="1,0,0,0" />
  </Style>
  <Style Selector="local|ThemeDockSkinHost.fleet.joined-left.joined-right">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="local|ThemeDockSkinHost.fleet dc|ToolChromeControl /template/ Border#PART_Border">
    <Setter Property="Margin" Value="0" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource FleetRimEdgeBrush}" />
  </Style>
  <Style Selector="local|ThemeDockSkinHost.fleet dc|ToolChromeControl /template/ Grid#PART_Grip">
    <Setter Property="Height" Value="{DynamicResource DockHeaderHeight}" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="{DynamicResource DockHeaderBrush}" />
  </Style>
  <Style Selector="local|ThemeDockSkinHost.fleet dc|ToolChromeControl /template/ TextBlock#PART_Title">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="local|ThemeDockSkinHost.fleet dc|ToolChromeControl /template/ Button">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="local|ThemeDockSkinHost.fleet dc|ToolControl /template/ Border#PART_Border">
    <Setter Property="Margin" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
</Styles>
